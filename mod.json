{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "danxsut.precision",
    "name": "Precision",
    "version": "v1.0.0",
    "developer": "Danx-sut",
    "description": "Ayuda de precision para clics",
    "dependencies": {
        "geode.node-ids": ">=v1.23.3"
    },
    "settings": {
        "assist-enabled": {
            "type": "bool",
            "name": "Activar ayuda",
            "description": "Enciende o apaga la ayuda de precision.",
            "default": true
        },
        "buffer-frames": {
            "type": "int",
            "name": "Ayuda (frames)",
            "description": "0 = sin ayuda. Mas frames = mas ayuda.",
            "default": 3,
            "min": 0,
            "max": 10,
            "control": { "slider": true }
        }
    }
}
